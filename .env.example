# ─────────────────────────────────────────────
#  RealtorFinder — Environment Variables
#  Copy to .env and fill in real values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────

# ── Server ────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Database ──────────────────────────────────
# Preferred: single connection string (Heroku/Render style)
DATABASE_URL=postgresql://user:password@host:5432/realtorfinder

# Alternative: individual components (used only when DATABASE_URL is unset)
# DB_USER=realtorfinder
# DB_PASSWORD=change_me
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=realtorfinder

# ── Session ───────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')|process.stdout.write"
SESSION_SECRET=change_me_to_a_64_byte_random_hex_string

# ── Stripe ────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
# Obtain from Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs from Stripe Dashboard → Products
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_FIRM=price_...

# ── SendGrid ──────────────────────────────────
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=noreply@realtorfinder.net
# CONTACT_EMAIL=info@realtorfinder.net   # optional — defaults to info@realtorfinder.net

# ── Cloudinary ────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Google OAuth ──────────────────────────────
GOOGLE_CLIENT_ID=...apps.googleusercontent.com

# ── Mapbox ────────────────────────────────────
MAPBOX_API_KEY=pk.eyJ1...

# ── Web Push (VAPID) ──────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...

# ── AI (Anthropic) ────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── reCAPTCHA (optional) ──────────────────────
# If unset, reCAPTCHA validation is skipped
RECAPTCHA_SECRET=...

# ── Google Search Console (optional) ──────────
# Meta-tag verification token for GSC
GSC_VERIFICATION_TOKEN=...

# ── App URL ───────────────────────────────────
FRONTEND_URL=https://realtorfinder.net
